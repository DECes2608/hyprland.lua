{
  "layer": "top",
  "position": "bottom",
  "height": 26,
  "spacing": 2,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["mpris"],
  "modules-right": ["tray", "pulseaudio", "clock"],

"hyprland/workspaces": {
  "format": "{id}",
  "all-outputs": false,
  "on-click": "activate"
},

"hyprland/window": {
  "format": "{}",
  "max-length": 40,
  "separate-outputs": true
},

"mpris": {
    "format": "{status_icon} {title}",
    "format-paused": "{status_icon} {title}",
    "status-icons": {
        "playing": "▶",
        "paused": "⏸"
    },
    "max-length": 30,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous"
},

  "custom/warp": {
    "format": "{}",
    "return-type": "json",
    "interval": 2,
    "exec": "~/.config/waybar/scripts/warp-toggle.sh",
    "on-click": "~/.config/waybar/scripts/warp-toggle.sh toggle",
    "tooltip": true
  },

  "custom/bluetooth": {
    "exec": "bluetoothctl show | grep -q 'Powered: yes' && echo '󰂯' || echo '󰂲'",
    "on-click": "blueman-manager",
    "on-click-right": "bluetoothctl power $(bluetoothctl show | grep -q 'Powered: yes' && echo 'off' || echo 'on')",
    "format": "{}",
    "interval": 2
  },

  "memory": {
    "interval": 2,
    "format": "󰍛 {used:0.1f}G",
    "tooltip-format": "Kullanılan: {used:0.1f}G / {total:0.1f}G"
  },

  "clock": {
    "format": "{:%I:%M %p}",
    "locale": "en_US.utf8",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "network": {
    "on-click": "nm-connection-editor",
    "on-click-right": "alacritty -e nmtui",
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format": "{essid} — {signalStrength}%"
  },

  "pulseaudio": {
    "format": "󰕾 {volume}%",
    "format-muted": "󰝟",
    "on-click": "pavucontrol"
  },

  "tray": {
    "icon-size": 14,
    "spacing": 6
  }
}
